{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "vayuloom-web": {
      "root": ".",
      "framework": "nextjs"
    },
    "vayuloom-agents": {
      "root": "services/agents",
      "entrypoint": "app:app",
      "buildCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/api/vayuloom-agents(/.*)?",
      "destination": {
        "type": "service",
        "service": "vayuloom-agents"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "vayuloom-web"
      }
    }
  ]
}
